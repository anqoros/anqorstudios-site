{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/document-compliance-automation",
      "destination": "/services/security-compliance",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ue4lley9dvtqd29ajwykwi53xor27z.html",
      "destination": "/api/facebook-domain-verify"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}
